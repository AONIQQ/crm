# Connection string used by Prisma CLI (migrate/push/studio) and the runtime client.
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# Log every SQL statement Prisma runs (debug level, bound parameters omitted).
# Off by default: it buries every other log line under a wall of SELECTs.
# PRISMA_LOG_QUERIES="true"
