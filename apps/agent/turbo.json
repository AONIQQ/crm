{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": { "dependsOn": ["^build"], "outputs": [".eve/**"] },
		"check-types": { "dependsOn": ["topo", "^build"] },
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": [
				"DATABASE_URL",
				"RAPIDAPI_KEY",
				"PERPLEXITY_API_KEY",
				"AI_GATEWAY_API_KEY"
			]
		}
	}
}
