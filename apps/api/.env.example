NODE_ENV="development"
PORT="3001"

# Same database as packages/db.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# openssl rand -base64 32. Must match apps/app/.env — the API mints the session
# cookie and the Next.js app verifies it.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"

# Origins allowed to call the API with credentials (the Next.js app). Also the
# allow-list Better Auth validates post-sign-in `callbackURL`s against.
AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Required. Google Cloud console -> Credentials -> OAuth client ID (web).
# Authorised redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only when the API and the app are on different subdomains, e.g. ".example.com".
# AUTH_COOKIE_DOMAIN=""

# Optional. Without it the cache is per-instance and in-memory.
# REDIS_URL="redis://localhost:6379"
# CACHE_TTL_MS="60000"

# Log every SQL statement Prisma runs (debug level, bound parameters omitted).
# Off by default: it buries every other log line under a wall of SELECTs.
# Log format and level are not configurable — they follow NODE_ENV.
# PRISMA_LOG_QUERIES="true"

# Context.dev, for the company enrichment agent (https://context.dev).
# Optional: without it the agent is disabled, a warning is logged once at boot,
# and companies stay PENDING. Server-side only — it never reaches the browser.
CONTEXT_DEV_API_KEY=""

# Where the Context.dev SDK points. Read by the SDK itself, not by our config —
# `test/enrichment.integration.spec.ts` uses it to drive the whole pipeline
# against a local stub. Leave unset in normal use.
# CONTEXT_DEV_BASE_URL="https://api.context.dev/v1"
