{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/internal/sync/google",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/internal/sync/rates",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/internal/telemetry/rollup",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "buildCommand": "cd ../../packages/db && DATABASE_URL=\"$DATABASE_URL_MIGRATE\" bunx prisma migrate deploy && cd ../../apps/api && bun scripts/bundle-serverless.ts"
}